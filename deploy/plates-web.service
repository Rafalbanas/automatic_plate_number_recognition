[Unit]
Description=Plates ALPR web demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plates-web
Group=plates-web
WorkingDirectory=/opt/plates-web
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PLATES_HOST=127.0.0.1
Environment=PLATES_PORT=20145
Environment=PLATES_MAX_FILE_BYTES=4194304
Environment=PLATES_MAX_PIXELS=12000000
Environment=PLATES_MAX_DIMENSION=4096
Environment=PLATES_API_TIMEOUT=15
Environment=XDG_CACHE_HOME=/var/cache/plates-web
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/var/lib/plates-web/venv/bin/python -m webapp.server
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
MemoryHigh=640M
MemoryMax=768M
MemorySwapMax=0
OOMPolicy=stop
CPUQuota=80%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/plates-web
ReadWritePaths=/var/cache/plates-web
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
