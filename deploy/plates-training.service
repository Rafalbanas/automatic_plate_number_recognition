[Unit]
Description=Resource-limited Plates detector training
After=network-online.target plates-prepare.service
Wants=network-online.target
Requires=plates-prepare.service

[Service]
Type=oneshot
User=plates-ml
Group=plates-ml
WorkingDirectory=/opt/plates-web
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PLATES_APP_ROOT=/opt/plates-web
Environment=PLATES_TRAINING_ROOT=/var/lib/plates-training
ExecStart=/usr/bin/python3 /opt/plates-web/scripts/resource_guard.py --status /var/lib/plates-training/resource-status.json --effective-total-mb 4096 --minimum-available-mb 768 --low-seconds 30 -- /usr/bin/nice -n 15 /opt/plates-web/scripts/run_training_pipeline.sh
Nice=15
CPUQuota=80%
IOSchedulingClass=idle
MemoryHigh=1536M
MemoryMax=2048M
MemorySwapMax=0
OOMPolicy=stop
Restart=no
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/plates-web
ReadWritePaths=/var/lib/plates-training
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
